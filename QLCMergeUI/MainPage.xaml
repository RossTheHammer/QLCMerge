<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:QLCMergeUI"
             xmlns:common="clr-namespace:QLCMerge.Common;assembly=QLCMerge.Common"
             xmlns:viewModels="clr-namespace:QLCMergeUI.ViewModels"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:Converters="clr-namespace:QLCMergeUI.ViewModels.Converters"
             x:Class="QLCMergeUI.MainPage"
             x:DataType="viewModels:MainViewModel">
    <!--xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"-->
    <ContentPage.BindingContext>
        <viewModels:MainViewModel/>
    </ContentPage.BindingContext>
    <ContentPage.Resources>
        <ResourceDictionary>
            <Converters:DefinitionMatchTypeToVisibilityConverter x:Key="definitionMatchTypeToVisibilityConverter"/>
            <DataTemplate x:Key="fixtureTile" x:DataType="common:FixtureDef">
                <HorizontalStackLayout Spacing="5">
                    <!--<Image Source="{FontImageSource FontFamily=MaterialOutlined, Glyph={x:Static m:MaterialOutlined.Folder}, Color={StaticResource Primary}}" />-->
                    <Label Text="{Binding Name}" FontAttributes="Bold" />
                    <Label Text="{Binding Model, StringFormat='[{0}]'}" />
                    <Label Text="{Binding Address, StringFormat='[{0}]'}" />
                    <Label Text="{Binding Channels, StringFormat='[{0}]'}" />
                </HorizontalStackLayout>
            </DataTemplate>
            <DataTemplate x:Key="functionTile" x:DataType="common:FunctionDef">
                <HorizontalStackLayout Spacing="5">
                    <!-- IsVisible="{Binding Matched, Converter={Static DefinitionMatchTypeToVisibilityConverter}}" -->
                    <!--<Image Source="{FontImageSource FontFamily=MaterialOutlined, Glyph={x:Static m:MaterialOutlined.Folder}, Color={StaticResource Primary}}" />-->
                    <Label Text="{Binding Name}" FontAttributes="Bold" Padding="5" />
                    <Label Text="{Binding Children.Count, StringFormat='({0})'}" />
                    <Label Text="{Binding ElemType, StringFormat='[{0}]'}" />
                    <Label Text="{Binding Matched}" />
                </HorizontalStackLayout>
            </DataTemplate>
            <!--<DataTemplate x:Key="folder" x:DataType="common:FunctionFolder">
                <HorizontalStackLayout Spacing="5">
                    --><!--<Image Source="{FontImageSource FontFamily=MaterialOutlined, Glyph={x:Static m:MaterialOutlined.Folder}, Color={StaticResource Primary}}" />--><!--
                    <Label Text="{Binding Name}" FontAttributes="Bold" />
                    <Label Text="{Binding Children.Count, StringFormat='({0})'}" />
                    <Label Text="{Binding ElemType, StringFormat='[{0}]'}" />
                </HorizontalStackLayout>
            </DataTemplate>
            <local:TreeNodeTemplateSelector x:Key="treeTileSelector"
                    Folder="{StaticResource folder}"
                    Leaf="{StaticResource functionTile}" />-->
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" x:Name="topBar">
            <Grid.ColumnDefinitions>
            </Grid.ColumnDefinitions>
        </Grid>
        <Grid Grid.Row="1" x:Name="fileDispay">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="80*"/>
            </Grid.RowDefinitions>
            
            <!-- LEFT FILE -->
            <Grid Grid.Row="0" Grid.Column="0" x:Name="leftControlBar">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Text="Select..." Command="{Binding LoadLeftCommand}"></Button>
                <Label Grid.Column="1" Text="{Binding LeftFilePath}"/>
                <Button Grid.Column="2" Text="Save"></Button>
            </Grid>
            <Border Grid.Row="1" Grid.Column="0" StrokeThickness="3">
                <CollectionView Grid.Row="1" Grid.Column="0" 
                    ItemsSource="{Binding LeftFixtures}"
                    ItemTemplate="{StaticResource fixtureTile}"/>
            </Border>
            <Border Grid.Row="2" Grid.Column="0" StrokeThickness="3">
                <CollectionView 
                    SelectionMode="Multiple"
                    ItemsSource="{Binding LeftFunctions}"
                    ItemTemplate="{StaticResource functionTile}"/>
            </Border>
            <!--<material:TreeView Grid.Row="2" Grid.Column="0" 
                    ItemsSource="{Binding LeftFunctions}"
                    ItemTemplate="{StaticResource functionTile}"
                    SelectionMode="Multiple"/>-->
            
            <!-- RIGHT FILE -->
            <Grid Grid.Row="0" Grid.Column="1" x:Name="rightControlBar">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Text="Select..." Command="{Binding LoadRightCommand}"></Button>
                <Label Grid.Column="1" Text="{Binding RightFilePath}"/>
                <Button Grid.Column="2" Text="Save"></Button>
            </Grid>
            <Border Grid.Row="1" Grid.Column="1" StrokeThickness="3">
                <CollectionView 
                    ItemsSource="{Binding RightFixtures}"
                    ItemTemplate="{StaticResource fixtureTile}"/>
            </Border>
            <Border Grid.Row="2" Grid.Column="1" StrokeThickness="3">
                <CollectionView 
                    SelectionMode="Multiple"
                    ItemsSource="{Binding RightFunctions}"
                    ItemTemplate="{StaticResource functionTile}"/>
            </Border>
            <!--<material:TreeView Grid.Row="2" Grid.Column="1" 
                    ItemsSource="{Binding RightFunctions}"
                    ItemTemplate="{StaticResource functionTile}"
                    SelectionMode="Multiple"/>-->

        </Grid>
        <!--<VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Image
                Source="dotnet_bot.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="dot net bot in a submarine number ten" />

            <Label
                Text="Hello, World!"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Welcome to &#10;.NET Multi-platform App UI"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2"
                SemanticProperties.Description="Welcome to dot net Multi platform App U I" />

            <Button
                x:Name="CounterBtn"
                Text="Click me" 
                SemanticProperties.Hint="Counts the number of times you click"
                Clicked="OnCounterClicked"
                HorizontalOptions="Fill" />
        </VerticalStackLayout>-->
    </Grid>

</ContentPage>
